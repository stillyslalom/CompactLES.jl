Manifest.toml
# Written by MPIPreferences.use_system_binary(); names one machine's MPI
# library by path, so it must never be shared between checkouts.
LocalPreferences.toml
docs/build/
# generated by docs/make.jl from docs/literate/ and examples/
docs/src/tutorials/
docs/src/examples/
docs/figures/.readme_header_cache.jls
# coverage artifacts
src/*.cov
*.cov
# run artifacts
*.dat
*.vtr
*.pvtr
*.pvd
*.ckpt
# cluster job logs; the conclusions are extracted into reference/ and the data
# is regenerable in hours
bench/logs/*.out

# questions for outside authors, kept locally
reference/AUTHOR_QUESTIONS.md

# cached runs of the documented examples (examples/common.jl, `cached`)
examples/cache/
